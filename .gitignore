node_modules/
dist/
*.log

# Kit scratch state. Never committed.
.kit/

# Secrets and per-host config. Never committed. Broad by intent: a bot token is the one file
# whose accidental commit cannot be undone by deleting it.
.env
.env.*
*.token
*token*.json
*token*.txt
secrets/
config.local.json

# The broker's persisted registry holds a process token per session. It defaults to a path outside
# the repo, but CHANNEL_BROKER_STATE can point it anywhere, so the name is ignored here too.
broker-state*.json

# Output of the hook-capture harness in tools/.
tools/hook-capture.jsonl
